extends layout

block content
  h2.title User List

  if users && users.length
    table.table.is-striped.is-bordered.is-fullwidth
      thead
        tr
          th User ID
          th Name
          th Email
      tbody
        each user in users
          tr
            td= user.userId
            td= user.name
            td= user.email
  else
    p.has-text-grey No users found.
